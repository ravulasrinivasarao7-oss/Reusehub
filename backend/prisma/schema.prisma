// ReUseHub Prisma schema.
// Part 1: SystemCheck (connectivity). Part 2: users, sessions, materials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder model from Part 1 (kept so the existing "init" migration stays valid).
model SystemCheck {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())

  @@map("system_checks")
}

model User {
  id                  Int                  @id @default(autoincrement())
  name                String               @db.VarChar(80)
  email               String               @unique @db.VarChar(254)
  passwordHash        String               @db.VarChar(100) // bcrypt hash, never the password
  phone               String?              @db.VarChar(30)
  location            String?              @db.VarChar(120)
  avatarUrl           String?              @db.VarChar(500)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  materials           Material[]
  requestsMade        MaterialRequest[]    @relation("MaterialRequestRequester")

  @@map("users")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

// Server-side login sessions. The browser holds a random token in an httpOnly
// cookie; only its SHA-256 hash is stored here.
model Session {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @db.VarChar(64)
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum MaterialCategory {
  CARDBOARD
  WOOD
  PAPER
  PLASTIC
  METAL
  FABRIC
  GLASS
  OTHER
}

enum MaterialCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  USED
}

model Material {
  id          Int               @id @default(autoincrement())
  title       String            @db.VarChar(120)
  description String            @db.VarChar(2000)
  category    MaterialCategory
  quantity    Int
  unit        String            @db.VarChar(30)
  condition   MaterialCondition
  location    String            @db.VarChar(120)
  imageUrl    String?           @db.VarChar(500)
  isAvailable Boolean           @default(true)
  ownerId     Int
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  requests    MaterialRequest[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
  @@index([category])
  @@index([condition])
  @@index([isAvailable, createdAt])
  @@map("materials")
}

enum MaterialRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model MaterialRequest {
  id          Int                   @id @default(autoincrement())
  materialId  Int
  requesterId Int
  status      MaterialRequestStatus @default(PENDING)
  material    Material              @relation(fields: [materialId], references: [id], onDelete: Cascade)
  requester   User                  @relation("MaterialRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([materialId, requesterId])
  @@index([requesterId, createdAt])
  @@index([materialId, status])
  @@index([materialId, createdAt])
  @@map("material_requests")
}
