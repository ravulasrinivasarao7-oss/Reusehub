# Copy this file to ".env" and replace the placeholders. Never commit ".env".
PORT=5000
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="ReUseHub <accounts@your-verified-domain.com>"
# Cloudinary console > Settings > API Keys. Replace with your own credentials.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
# Alternatively, use the SDK-supported URL instead of the three variables above.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Optional: serve legacy images previously saved under /uploads.
# MATERIAL_UPLOAD_DIR=/var/data/material-images
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE?schema=public"
