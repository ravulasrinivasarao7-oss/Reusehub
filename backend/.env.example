# Copy this file to ".env" and replace the placeholders. Never commit ".env".
PORT=5000
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_your_api_key
EMAIL_FROM="ReUseHub <accounts@your-verified-domain.com>"
# In production, point this at a persistent disk mounted by the host.
# Local development defaults to backend/uploads/material-images.
# MATERIAL_UPLOAD_DIR=/var/data/material-images
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://USER:URL_ENCODED_PASSWORD@HOST:PORT/DATABASE?schema=public"
